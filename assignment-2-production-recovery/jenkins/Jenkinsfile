pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Manjunath1007/devops-portfolio.git'
            }
        }

        stage('Debug Workspace') {
            steps {
                sh "pwd"
                sh "ls -R"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t account-service:latest assignment-2-production-recovery/"
            }
        }

        // ✅ Deploy stable version (v1)
        stage('Deploy v1') {
            steps {
                sh "kubectl apply -f assignment-2-production-recovery/kubernetes/deployment.yaml"
                sh "kubectl apply -f assignment-2-production-recovery/kubernetes/service.yaml"
            }
        }

        // ✅ Deploy canary version (v2)
        stage('Deploy v2 Canary') {
            steps {
                sh "kubectl apply -f assignment-2-production-recovery/kubernetes/deployment-v2.yaml"
            }
        }

        stage('Verify Deployment') {
            steps {
                sh "kubectl rollout status deployment/account-deployment --timeout=60s"
                sh "kubectl rollout status deployment/account-deployment-v2 --timeout=60s"
            }
        }

        // ✅ Health validation
        stage('Health Check') {
            steps {
                script {
                    retry(5) {
                        sh '''
                        echo "Checking application health..."
                        sleep 5
                        kubectl run test --rm -i --restart=Never \
                        --image=curlimages/curl -- curl -f account-service
                        '''
                    }
                }
            }
        }

        // ✅ Optional: promote canary (increase traffic)
        stage('Promote Canary') {
            steps {
                sh "kubectl scale deployment account-deployment-v2 --replicas=3"
            }
        }
    }

    // ✅ FINAL DECISION LOGIC
    post {

        success {
            echo "✅ Deployment Successful — Canary promoted"
        }

        failure {
            echo "❌ Deployment Failed — Rolling back..."

            sh '''
            kubectl rollout undo deployment/account-deployment || true
            kubectl delete deployment account-deployment-v2 --ignore-not-found
            '''

            echo "✅ Rollback Completed"
        }

        always {
            cleanWs()
        }
    }
}

